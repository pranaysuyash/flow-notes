# API Keys Configuration
# Copy this file to .env and add your actual API keys

# OpenAI API Key (for GPT-4, GPT-5-nano, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key (for Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Ollama Configuration (for local models - no API key needed!)
OLLAMA_MODEL=llama2
OLLAMA_HOST=http://localhost:11434

# Default LLM provider
# Options: openai, anthropic, ollama, google
# Use 'ollama' for complete privacy (local models)
DEFAULT_LLM_PROVIDER=openai

# Note: You only need ONE provider configured to use the system
# For privacy-first setup, use ollama (no API keys required)
